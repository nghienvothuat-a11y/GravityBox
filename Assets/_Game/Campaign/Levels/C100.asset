  DisplayName: "V\u0169 tr\u1EE5 trong l\xF2ng b\xE0n tay"
  Shape: 17
  TeachingHint: "Gi\xFAp hai bi m\u1EDF \u0111\u01B0\u1EDDng cho nhau. Gi\u1EEF n\u1EA5c
    cam, qua l\u1ED3ng r\u1ED3i \u0111\xF3n t\u1EEBng bi \u1EDF s\xE2n cu\u1ED1i."
  Environment: {fileID: 11400000, guid: 82e0ce24addfe4fc89b8bbd0db998aea, type: 2}
