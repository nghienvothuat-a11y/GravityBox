  DisplayName: "M\xEA cung v\u1EA1n hoa"
  Shape: 3
  TeachingHint: "\u0110\u1ED5i m\u1EB7t \u0111\u1EE1 qua c\xE1c nh\xE1nh. Ch\u1ECDn
    m\u1ED1c ti\u1EBFp theo tr\u01B0\u1EDBc khi xoay c\u1EA3 kh\u1ED1i c\u1EA7u."
