  Design: {fileID: 11400000, guid: e83558e96c99840ffaeae32135422a4f, type: 2}
  DesignerSolution: "Gi\u1EDBi thi\u1EC7u m\u1ED9t h\xE0nh \u0111\u1ED9ng: xoay h\u1ED9p
    \u0111\u1EC3 \u0111\u01B0a s\xE2n nh\u1EADn v\xE0o d\u01B0\u1EDBi qu\u1EF9 \u0111\u1EA1o
    bay; kh\xF4ng t\xE1c \u0111\u1ED9ng l\u1EF1c tr\u1EF1c ti\u1EBFp l\xEAn bi. B\u1ED1
    tr\xED: P21 \u2014 s\xE2n nh\u1EADn l\u1EC7ch nh\u1EB9 sang b\xEAn, d\u1ED1c
    d\xE0i v\u1EEBa \u0111\u1EE7 \u0111\u1EC3 th\u1EA5y v\xE0 b\u1EAFt \u0111\u1EA7u
    xoay tr\u01B0\u1EDBc khi bi r\u1EDDi m\xE9p.\nRecovery: H\u1EE5t s\xE2n nh\u1EADn
    r\u01A1i xu\u1ED1ng t\u1EA7ng h\u1EE9ng c\u1EE5c b\u1ED9, tr\u1EDF l\u1EA1i t\xFAi
    ph\xF3ng b\u1EB1ng m\u1ED9t \u0111o\u1EA1n chuy\u1EC3n m\u1EB7t \u0111\u1EE1
    \u0111\xE3 h\u1ECDc"
