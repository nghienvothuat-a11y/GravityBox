  DisplayName: "Gi\u1EEF \u0111\u01B0\u1EDDng cho b\u1EA1n"
  Shape: 15
  TeachingHint: "M\u1ED9t bi t\u1EDBi v\u1ECB tr\xED ti\u1EBFp x\xFAc \u0111\u1EC3
    gi\u1EEF \u0111\u01B0\u1EDDng cho bi c\xF2n l\u1EA1i."
  Environment: {fileID: 11400000, guid: 82e0ce24addfe4fc89b8bbd0db998aea, type: 2}
